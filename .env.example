# ─── Demo website ────────────────────────────────────────────────────────────

# Host port the demo website is published on (docker compose).
APP_PORT=8080

# Host address the website is published on: 0.0.0.0 for all interfaces (e.g. behind a
# reverse proxy on another host), 127.0.0.1 to keep it on this machine (the installer's choice).
APP_BIND=0.0.0.0

# Port the demo app listens on inside its container.
PORT=8080

# Demo versions to run, comma-separated and in the order the landing page lists them; each
# needs its own pair of browser containers named after BROWSER_HOST_PATTERN (see the compose
# files). Available: full-story, attacker-view, challenge-binding
DEMOS=full-story,attacker-view,challenge-binding

# Basic-auth credentials for the whole demo (website, remote browsers, controls).
# The two browsers are interactive, so always set a password on a public deployment.
# Leave DEMO_PASSWORD empty to disable authentication (local use only).
# Generate one with: openssl rand -base64 18
DEMO_USERNAME=demo
DEMO_PASSWORD=

# Where people get this project to run it themselves: linked, with a QR code, on the
# landing page.
PROJECT_URL=https://github.com/lonetis/passkeys-demo

# "Do it for me": pause in milliseconds before each action, while the highlight in the
# browser shows where it happens. Raise it if the audience cannot follow.
AUTOPILOT_PAUSE_MS=2000

# ─── Upstream services used in the demo ─────────────────────────────────────

# Fun with Flags and Passkeys (the CTF / learning platform).
LEARNING_URL=https://learning.passkeys.tools

# PASSKEYS-ATTACKER frontend the extension opens its interceptor on.
PASSKEYS_TOOLS_URL=https://passkeys.tools

# PASSKEYS-ATTACKER remote storage backend shared by both browsers.
PASSKEYS_TOOLS_DB_URL=https://db.passkeys.tools

# CTF verifier IDs preselected in the browsers (see LEARNING_URL/verifiers for the list):
# the vulnerable registration ("Cred Overwrite"), the passkey login of the full story
# ("Discoverable"), the username-first login of the attacker's view ("Non-Discoverable"),
# and for the challenge binding test a correct registration ("All Algorithms") and the
# login that accepts challenges from other sessions ("Cross-Session Challenge").
REGISTRATION_VERIFIER_ID=60
DISCOVERABLE_LOGIN_VERIFIER_ID=2
USERNAME_FIRST_LOGIN_VERIFIER_ID=4
STANDARD_REGISTRATION_VERIFIER_ID=29
CROSS_SESSION_LOGIN_VERIFIER_ID=17

# ─── Remote browsers ────────────────────────────────────────────────────────

# Resolution of each remote browser's screen.
SCREEN_WIDTH=1152
SCREEN_HEIGHT=720

# Browser skin colors (Chromium BrowserThemeColor policy).
VICTIM_THEME_COLOR=#F9A825
ATTACKER_THEME_COLOR=#C62828

# Comma-separated hosts the browsers may navigate to (subdomains included); everything else is
# blocked so the public remote browsers cannot be used for general browsing.
ALLOWED_HOSTS=passkeys.tools

# Only change these when not using the provided compose files:
# hostname of each browser container as seen from the app container ({demo} and {role} =
# victim/attacker are replaced),
BROWSER_HOST_PATTERN={demo}-{role}
# their DevTools (CDP) and VNC ports,
BROWSER_CDP_PORT=9223
BROWSER_VNC_PORT=5900
# and the extension's path inside the browser image (determines the extension ID).
EXTENSION_PATH=/opt/passkeys-tools-extension

# ─── One-line installer (install.sh) ────────────────────────────────────────
# Set these in the shell when running the installer, not in .env, e.g.
#   curl -fsSL https://raw.githubusercontent.com/lonetis/passkeys-demo/main/install.sh | APP_PORT=9000 sh
# APP_PORT (above) picks the port of a new install. The installer writes a .env with only
# APP_BIND=127.0.0.1 and APP_PORT; everything else keeps the defaults listed here.

# Directory the installer puts the compose file and .env in. It must not exist yet or belong
# to you (in a shared /tmp, a directory someone else created is refused).
PASSKEYS_DEMO_DIR=/tmp/passkeys-demo

# Where the installer downloads docker-compose.prod.yml and .env.example from.
PASSKEYS_DEMO_SOURCE=https://raw.githubusercontent.com/lonetis/passkeys-demo/main
